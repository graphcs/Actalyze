# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright — specs are tracked, run output is not
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.test-results/
tests/e2e/screenshots/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cursor
.cursor/

# claude code scratch (agent worktrees)
.claude/worktrees/

# downloaded source PDFs for scripts/pk/ingest-documents.mjs — re-fetchable, and the
# Council of Islamic Ideology's annual reports alone run to 120MB
.pk-doc-cache/
# COD-AB source download for scripts/pk/build-province-geo.mjs — re-fetchable,
# and the district layer alone is 11MB
.pk-geo-cache/

# downloaded sample notifications for data/pk/NOTIFICATION-FORMAT.md — all scans,
# re-fetchable, and one of them is 7MB
.pk-notice-samples/
