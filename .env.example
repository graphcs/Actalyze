# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Existing variables (keep your actual values)
# OPENROUTER_API_KEY=...
# TWITTER_API_KEY=...
# etc.

# Cron authentication
# Shared secret for /api/admin/cron/check-alerts; the scheduler must send it as
# "Authorization: Bearer <value>". If unset, that endpoint returns 503 (fails closed).
# CRON_SECRET=

# LLM provider selection
# OpenAI is primary whenever OPENAI_API_KEY is set. OpenRouter is used only when
# OpenAI is absent, or when forced here. Set this to true once the OpenRouter key
# is valid again — it routes to perplexity/sonar, which can search the web.
# USE_OPENROUTER=true

# Access mode override
# Overrides the mode stored in Supabase app_settings without a database write.
# public = open to everyone | guest = guest cookie allowed | restricted = allowlist
# AUTH_MODE=public

# Note on the tweet feed: X's free API tier does not permit search, so
# /api/tweets/search recovers genuine tweets via SerpAPI (SERPAPI_KEY) instead.
# Real handles, ids, text and engagement — see lib/serpapi-tweets.ts.
